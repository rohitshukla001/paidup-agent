# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=8080

# PayPal sandbox (Task 2)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Optional. The merchant email on invoices; empty means the REST app owner.
PAYPAL_INVOICER_EMAIL=
# Optional. Where the sandbox test sends its invoice (your sandbox
# Personal account email).
PAYPAL_TEST_RECIPIENT=

# Gemini (Task 3). Put the current Flash and Flash-Lite model IDs from Google AI Studio here.
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_FALLBACK=
# Keep this below the free-tier requests-per-minute limit of the primary model.
GEMINI_MAX_CALLS_PER_MINUTE=8

# Database (Task 5)
DATABASE_URL=postgres://paidup:paidup@localhost:5432/paidup?sslmode=disable

# Demo access (Task 6)
DEMO_PASSWORD=
ADMIN_TOKEN=
SESSION_SECRET=
